{
  "name": "backup-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "bkagent": "tsx packages/cli/src/main.ts",
    "build:cli": "esbuild packages/cli/src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/bkagent.mjs --external:node:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "esbuild": "0.28.2"
  }
}
